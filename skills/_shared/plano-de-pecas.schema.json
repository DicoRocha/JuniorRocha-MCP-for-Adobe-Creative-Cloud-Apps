{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plano de peças (jradb_campaign_run)",
  "type": "object",
  "required": ["pecas"],
  "properties": {
    "cliente": { "type": "string" },
    "campanha": { "type": "string" },
    "aprovacoes": {
      "type": "array",
      "items": { "enum": ["conceito", "arte-chave", "video"] },
      "description": "Pontos onde a execução para até a aprovação (padrão: os três)."
    },
    "pecas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tipo"],
        "properties": {
          "id": { "type": "string", "description": "P01, P02…" },
          "tipo": {
            "enum": [
              "fotos-lote", "pacote-logo", "templates", "remover-fundo", "produto", "formatos", "lote-variantes",
              "lote-vetor", "lower-third", "titulo", "contador", "logo-reveal", "transicao", "reel", "flyer",
              "catalogo", "manual", "mesclagem", "folha-contato", "pacote-grafica", "tool", "a-mao"
            ]
          },
          "nome": { "type": "string" },
          "etapa": { "enum": ["atencao", "consideracao", "conversao", "relacionamento"] },
          "canal": { "type": "string" },
          "etapaProducao": { "enum": ["fotos", "vetores", "arte-chave", "derivacoes", "motion", "video", "impressos", "pacote"] },
          "ferramenta": { "type": "string", "description": "tipo 'tool': nome de qualquer ferramenta do MCP." },
          "params": {
            "type": "object",
            "description": "Argumentos da ferramenta. Caminhos começando com '@/' são relativos à pasta da campanha. kitPath entra sozinho quando a ferramenta aceita."
          },
          "depende": { "type": "array", "items": { "type": "string" } },
          "observacao": { "type": "string" }
        }
      }
    }
  }
}
